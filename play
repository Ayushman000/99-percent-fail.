// Daily challenge generator
function makeDailyLevel(){
  const rng=makeRNG(getDailySeed());
  const walls=[];
  const nw=2+Math.floor(rng()*3);
  for(let i=0;i<nw;i++){
    const horiz=rng()>.5;
    walls.push({
      x:ARENA.x+60+rng()*(ARENA.w-200),
      y:ARENA.y+60+rng()*(ARENA.h-200),
      w:horiz?80+rng()*120:16,
      h:horiz?16:80+rng()*120,
    });
  }
  const balls=[];
  const nb=1+Math.floor(rng()*3);
  for(let i=0;i<nb;i++){
    balls.push({
      x:ARENA.x+100+rng()*(ARENA.w-200),
      y:ARENA.y+100+rng()*(ARENA.h-200),
      r:11+rng()*5,
      vx:(rng()>.5?1:-1)*(100+rng()*80),
      vy:(rng()>.5?1:-1)*(100+rng()*80),
    });
  }
  const spinners=[];
  if(rng()>.4){
    spinners.push({
      cx:ARENA.x+ARENA.w/2+rng()*100-50,
      cy:ARENA.y+ARENA.h/2+rng()*80-40,
      len:150+rng()*100,thick:12,
      speed:(rng()>.5?1:-1)*(1.2+rng()),angle:rng()*Math.PI,
    });
  }
  const chasers=[];
  if(rng()>.5) chasers.push({x:ARENA.x+ARENA.w/2,y:ARENA.y+ARENA.h/2,r:13,speed:0.45+rng()*0.15});
  return{
    name:"Daily Challenge",hint:"Same challenge for everyone today!",
    playerStart:{x:80,y:500},goal:{x:700,y:80,size:22},
    walls,balls,spinners,chasers,
    timeLimit:8+Math.floor(rng()*6),
    invertControls:false,phantomWalls:false,fakeGoal:null,
  };
}

// ===== STORAGE =====
const Store = {
  data: { bestLevel:0, bestScore:0, skin:'default', unlocks:['default'], dailyBest:0, dailyDate:'' },
  load(){
    try{
      const s=localStorage.getItem('99pf_save');
      if(s){const d=JSON.parse(s);Object.assign(this.data,d)}
    }catch(e){}
  },
  save(){
    try{localStorage.setItem('99pf_save',JSON.stringify(this.data))}catch(e){}
  },
  unlock(skinId){
    if(!this.data.unlocks.includes(skinId)){
      this.data.unlocks.push(skinId);
      this.save();
      return true;
    }
    return false;
  },
  isUnlocked(skinId){return this.data.unlocks.includes(skinId)},
};
Store.load();

// ===== GAME ENGINE =====
const game = {
  state: 'menu', // menu, intro, playing, dying, levelComplete, gameOver, victory, paused, daily
  prevState: 'menu',
  currentLevel: 0,
  score: 0,
  levelData: null,
  levels: null,
  isDaily: false,

  // Player
  px: 0, py: 0, pvx: 0, pvy: 0,
  playerAlive: true,
  playerTrail: [],

  // Level objects (runtime state)
  balls: [],
  spinners: [],
  chasers: [],
  walls: [],
  phantomWalls: [],
  goalPulse: 0,
  fakeGoal: null,

  // Goal
  gx: 0, gy: 0, gsize: 22,

  // Timers
  stateTimer: 0,
  levelTime: 0,
  timeLimit: 0,
  nearMissCooldown: 0,
  nearMissFlash: 0,
  shakeIntensity: 0,
  invertControls: false,
  arenaShrinksAfter: 0,
  arenaShrink: 0,

  // Scoring
  nearMissCount: 0,
  levelStartTime: 0,

  // HUD flash texts
  flashTexts: [],

  init(){
    this.levels = makeLevels();
    Input.init();
    this.updateSkinSelector();
    this.updateBestDisplay();
    this.bindUI();
  },

  bindUI(){
    const $=id=>document.getElementById(id);
    $('playBtn').onclick=()=>{Sound.init();Sound.play('click');this.startGame(false)};
    $('dailyBtn').onclick=()=>{Sound.init();Sound.play('click');this.startGame(true)};
    $('retryBtn').onclick=()=>{Sound.play('click');this.startGame(this.isDaily)};
    $('shareBtn').onclick=()=>this.share(false);
    $('shareVictoryBtn').onclick=()=>this.share(true);
    $('continueBtn').onclick=()=>{Sound.play('click');this.continueAfterVictory()};
    $('resumeBtn').onclick=()=>{Sound.play('click');this.resume()};
    $('quitBtn').onclick=()=>{Sound.play('click');this.quit()};
    $('soundBtn').onclick=()=>{
      Sound.init();Sound.toggle();
      $('soundBtn').textContent=Sound.muted?'🔇':'🔊';
    };
    $('pauseBtn2').onclick=()=>{
      if(this.state==='playing') this.pause();
      else if(this.state==='paused') this.resume();
    };
    window.addEventListener('keydown',e=>{
      if(e.code==='Escape'){
        if(this.state==='playing') this.pause();
        else if(this.state==='paused') this.resume();
      }
      if(e.code==='KeyR'&&(this.state==='gameOver'||this.state==='dying')){
        Sound.play('click');this.startGame(this.isDaily);
      }
    });
  },

  showScreen(id){
    document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));
    if(id){const el=document.getElementById(id);if(el)el.classList.remove('hidden')}
    const pb=document.getElementById('pauseBtn2');
    if(!id&&this.state!=='menu') pb.classList.remove('hidden');
    else pb.classList.add('hidden');
  },

  updateBestDisplay(){
    const d=Store.data;
    const txt=d.bestLevel>0?`Best: Level ${d.bestLevel} — ${d.bestScore} pts`:'Best: —';
    document.getElementById('bestDisplay').innerHTML=`${txt}`;
  },

  updateSkinSelector(){
    const sel=document.getElementById('skinSelector');
    sel.innerHTML='';
    SKINS.forEach(sk=>{
      const div=document.createElement('div');
      div.className='skin-opt';
      const unlocked=sk.unlock===null||Store.isUnlocked(sk.id);
      if(!unlocked) div.classList.add('locked');
      if(Store.data.skin===sk.id) div.classList.add('active');
      const col=sk.color==='rainbow'?'linear-gradient(135deg,#ff0000,#ffaa00,#00ff00,#0088ff,#aa00ff)':sk.color;
      div.style.background=col;
      div.title=unlocked?sk.name:`${sk.name} — Reach Level ${sk.unlock} to unlock`;
      div.onclick=()=>{
        if(!unlocked) return;
        Sound.play('click');
        Store.data.skin=sk.id;
        Store.save();
        this.updateSkinSelector();
      };
      sel.appendChild(div);
    });
  },

  startGame(daily){
    this.isDaily=daily;
    this.currentLevel=0;
    this.score=0;
    this.nearMissCount=0;
    if(daily){
      this.levels=[makeDailyLevel()];
    } else {
      this.levels=makeLevels();
    }
    this.loadLevel(0);
    this.showScreen(null);
    this.state='intro';
    this.stateTimer=INTRO_TIME;
  },

  loadLevel(n){
    if(n>=this.levels.length){
      if(this.isDaily){this.dailyVictory();return}
      this.victory();return;
    }
    this.currentLevel=n;
    const lv=this.levels[n];
    this.levelData=lv;

    // Player
    this.px=lv.playerStart.x-PLAYER_SIZE/2;
    this.py=lv.playerStart.y-PLAYER_SIZE/2;
    this.pvx=0;this.pvy=0;
    this.playerAlive=true;
    this.playerTrail=[];

    // Goal
    this.gx=lv.goal.x; this.gy=lv.goal.y; this.gsize=lv.goal.size;
    this.goalPulse=0;

    // Walls
    this.walls=lv.walls.map(w=>({...w}));

    // Balls
    this.balls=lv.balls.map(b=>({...b}));

    // Spinners
    this.spinners=lv.spinners.map(s=>({...s}));

    // Chasers
    this.chasers=lv.chasers.map(c=>({...c}));

    // Phantom walls
    this.phantomWalls=lv.phantomWalls&&lv.phantomWallData?lv.phantomWallData.map(w=>({...w})):[];

    // Fake goal
    this.fakeGoal=lv.fakeGoal?{...lv.fakeGoal}:null;

    // Timers
    this.levelTime=0;
    this.timeLimit=lv.timeLimit||0;
    this.invertControls=lv.invertControls||false;
    this.arenaShrinksAfter=lv.arenaShrinksAfter||0;
    this.arenaShrink=0;
    this.nearMissCooldown=0;
    this.nearMissFlash=0;
    this.shakeIntensity=0;
    this.flashTexts=[];
    this.levelStartTime=performance.now();
  },

  startPlaying(){
    this.state='playing';
  },

  getArena(){
    const shrink=this.arenaShrink;
    return{
      x:ARENA.x+shrink,y:ARENA.y+shrink,
      w:ARENA.w-shrink*2,h:ARENA.h-shrink*2
    };
  },

  update(dt){
    this.goalPulse+=dt*3;
    updateParticles(dt);

    if(this.state==='intro'){
      this.stateTimer-=dt;
      // Animate obstacles during intro so player can see patterns
      this.updateObstacles(dt);
      if(this.stateTimer<=0) this.startPlaying();
      return;
    }

    if(this.state==='playing'){
      this.levelTime+=dt;
      this.nearMissCooldown=Math.max(0,this.nearMissCooldown-dt);
      this.nearMissFlash=Math.max(0,this.nearMissFlash-dt);
      this.shakeIntensity*=0.9;

      // Arena shrink
      if(this.arenaShrinksAfter>0&&this.levelTime>this.arenaShrinksAfter){
        this.arenaShrink=Math.min(120,(this.levelTime-this.arenaShrinksAfter)*12);
      }

      // Time limit
      if(this.timeLimit>0){
        const remaining=this.timeLimit-this.levelTime;
        if(remaining<=0){this.die();return}
      }

      // Player movement
      const dir=Input.getDir(this.invertControls);
      this.pvx=dir.x*PLAYER_SPEED;
      this.pvy=dir.y*PLAYER_SPEED;
      this.px+=this.pvx*dt;
      this.py+=this.pvy*dt;

      // Clamp to arena
      const ar=this.getArena();
      this.px=clamp(this.px,ar.x,ar.x+ar.w-PLAYER_SIZE);
      this.py=clamp(this.py,ar.y,ar.y+ar.h-PLAYER_SIZE);

      // Trail
      const skin=SKINS.find(s=>s.id===Store.data.skin)||SKINS[0];
      if(skin.trail||(Math.abs(this.pvx)>10||Math.abs(this.pvy)>10)){
        this.playerTrail.push({x:this.px+PLAYER_SIZE/2,y:this.py+PLAYER_SIZE/2,life:0.3});
      }
      this.playerTrail=this.playerTrail.filter(t=>{t.life-=dt;return t.life>0});

      // Update obstacles
      this.updateObstacles(dt);

      // Collision checks
      this.checkCollisions();

      // Update flash texts
      this.flashTexts=this.flashTexts.filter(f=>{f.life-=dt;f.y-=30*dt;return f.life>0});
    }

    if(this.state==='dying'){
      this.stateTimer-=dt;
      this.shakeIntensity*=0.95;
      if(this.stateTimer<=0) this.gameOver();
    }

    if(this.state==='levelComplete'){
      this.stateTimer-=dt;
      this.updateObstacles(dt);
      if(this.stateTimer<=0){
        this.loadLevel(this.currentLevel+1);
        if(this.state!=='victory'&&this.state!=='gameOver'){
          this.state='intro';
          this.stateTimer=INTRO_TIME;
        }
      }
    }
  },

  updateObstacles(dt){
    const ar=this.getArena();

    // Balls
    for(const b of this.balls){
      b.x+=b.vx*dt; b.y+=b.vy*dt;
      if(b.x-b.r<ar.x){b.x=ar.x+b.r;b.vx=Math.abs(b.vx)}
      if(b.x+b.r>ar.x+ar.w){b.x=ar.x+ar.w-b.r;b.vx=-Math.abs(b.vx)}
      if(b.y-b.r<ar.y){b.y=ar.y+b.r;b.vy=Math.abs(b.vy)}
      if(b.y+b.r>ar.y+ar.h){b.y=ar.y+ar.h-b.r;b.vy=-Math.abs(b.vy)}
    }

    // Spinners
    for(const s of this.spinners){
      s.angle+=s.speed*dt;
    }

    // Chasers
    if(this.state==='playing'){
      for(const c of this.chasers){
        const pcx=this.px+PLAYER_SIZE/2,pcy=this.py+PLAYER_SIZE/2;
        const dx=pcx-c.x,dy=pcy-c.y;
        const d=Math.hypot(dx,dy);
        if(d>1){
          c.x+=dx/d*PLAYER_SPEED*c.speed*dt;
          c.y+=dy/d*PLAYER_SPEED*c.speed*dt;
        }
      }
    }
  },

  checkCollisions(){
    const pcx=this.px+PLAYER_SIZE/2,pcy=this.py+PLAYER_SIZE/2;
    const ar=this.getArena();

    // Check goal
    if(dist(pcx,pcy,this.gx,this.gy)<(PLAYER_SIZE/2+this.gsize/2)){
      this.levelWin();return;
    }

    // Check fake goal
    if(this.fakeGoal){
      if(dist(pcx,pcy,this.fakeGoal.x,this.fakeGoal.y)<(PLAYER_SIZE/2+this.fakeGoal.size/2)){
        this.die();return;
      }
    }

    // Check walls
    for(const w of this.walls){
      if(rectsOverlap(this.px,this.py,PLAYER_SIZE,PLAYER_SIZE,w.x,w.y,w.w,w.h)){
        this.die();return;
      }
      // Near miss
      if(this.nearMissCooldown<=0){
        const nx=clamp(pcx,w.x,w.x+w.w),ny=clamp(pcy,w.y,w.y+w.h);
        const d=dist(pcx,pcy,nx,ny)-PLAYER_SIZE/2;
        if(d>0&&d<NEAR_MISS_DIST) this.nearMiss(pcx,pcy);
      }
    }

    // Check balls
    for(const b of this.balls){
      if(rectCircle(this.px,this.py,PLAYER_SIZE,PLAYER_SIZE,b.x,b.y,b.r)){
        this.die();return;
      }
      if(this.nearMissCooldown<=0){
        const d=dist(pcx,pcy,b.x,b.y)-b.r-PLAYER_SIZE/2;
        if(d>0&&d<NEAR_MISS_DIST) this.nearMiss(pcx,pcy);
      }
    }

    // Check spinners
    for(const s of this.spinners){
      if(rectRotRectOverlap(this.px,this.py,PLAYER_SIZE,s.cx,s.cy,s.len/2,s.thick/2,s.angle)){
        this.die();return;
      }
      if(this.nearMissCooldown<=0){
        const d=distToRotRect(pcx,pcy,s.cx,s.cy,s.len/2,s.thick/2,s.angle)-PLAYER_SIZE/2;
        if(d>0&&d<NEAR_MISS_DIST) this.nearMiss(pcx,pcy);
      }
    }

    // Check chasers
    for(const c of this.chasers){
      if(rectCircle(this.px,this.py,PLAYER_SIZE,PLAYER_SIZE,c.x,c.y,c.r)){
        this.die();return;
      }
      if(this.nearMissCooldown<=0){
        const d=dist(pcx,pcy,c.x,c.y)-c.r-PLAYER_SIZE/2;
        if(d>0&&d<NEAR_MISS_DIST) this.nearMiss(pcx,pcy);
      }
    }

    // Check phantom walls
    for(const pw of this.phantomWalls){
      const cycle=2.5;
      const t=(this.levelTime+pw.phase)%cycle;
      const visible=t<1.8;
      if(visible&&rectsOverlap(this.px,this.py,PLAYER_SIZE,PLAYER_SIZE,pw.x,pw.y,pw.w,pw.h)){
        this.die();return;
      }
    }

    // Check arena bounds (for shrinking arena)
    if(this.px<=ar.x||this.px+PLAYER_SIZE>=ar.x+ar.w||
       this.py<=ar.y||this.py+PLAYER_SIZE>=ar.y+ar.h){
      if(this.arenaShrink>5){this.die();return}
    }
  },

  nearMiss(x,y){
    this.nearMissCooldown=NEAR_MISS_COOLDOWN;
    this.nearMissFlash=0.4;
    this.nearMissCount++;
    this.score+=50;
    Sound.play('nearmiss');
    emitParticles(x,y,8,C.nearMiss,80,0.5,[2,4]);
    this.flashTexts.push({text:'CLOSE!',x,y:y-20,life:0.7,color:C.nearMiss});
  },

  levelWin(){
    this.state='levelComplete';
    this.stateTimer=LEVEL_COMPLETE_TIME;
    const timeBonus=Math.max(0,Math.floor((30-this.levelTime)*10));
    const levelScore=(this.currentLevel+1)*100+timeBonus;
    this.score+=levelScore;
    Sound.play('goal');
    emitParticles(this.gx,this.gy,30,C.goal,150,1,[3,6]);
    this.flashTexts.push({text:`+${levelScore}`,x:this.gx,y:this.gy-20,life:1,color:C.goal});

    // Check unlocks
    const levelNum=this.currentLevel+1;
    this.checkUnlock(levelNum);

    // Update best
    if(levelNum>Store.data.bestLevel){
      Store.data.bestLevel=levelNum;
      Store.save();
    }
    Sound.play('levelup');
  },

  checkUnlock(levelReached){
    SKINS.forEach(sk=>{
      if(sk.unlock===levelReached){
        if(Store.unlock(sk.id)){
          Sound.play('unlock');
          this.showUnlockToast(sk);
        }
      }
    });
  },

  showUnlockToast(skin){
    const toast=document.createElement('div');
    toast.className='unlock-toast';
    toast.innerHTML=`<h3>🎨 Skin Unlocked!</h3><p>${skin.name}</p>`;
    document.body.appendChild(toast);
    setTimeout(()=>toast.remove(),2500);
  },

  die(){
    if(!this.playerAlive) return;
    this.playerAlive=false;
    this.state='dying';
    this.stateTimer=DEATH_ANIM_TIME;
    this.shakeIntensity=12;
    Sound.play('death');
    const pcx=this.px+PLAYER_SIZE/2,pcy=this.py+PLAYER_SIZE/2;
    const skin=SKINS.find(s=>s.id===Store.data.skin)||SKINS[0];
    const col=skin.color==='rainbow'?'#ff44aa':skin.color;
    emitParticles(pcx,pcy,25,col,200,0.8,[3,7]);
    emitParticles(pcx,pcy,15,'#ffffff',120,0.5,[1,3]);
  },

  gameOver(){
    this.state='gameOver';
    const levelNum=this.currentLevel+1;
    // Update best
    let isNewBest=false;
    if(this.isDaily){
      const today=getDailySeed().toString();
      if(this.score>Store.data.dailyBest||Store.data.dailyDate!==today){
        Store.data.dailyBest=this.score;
        Store.data.dailyDate=today;
        isNewBest=true;
      }
    } else {
      if(this.score>Store.data.bestScore){
        Store.data.bestScore=this.score;
        isNewBest=true;
      }
      if(levelNum>Store.data.bestLevel){
        Store.data.bestLevel=levelNum;
        isNewBest=true;
      }
    }
    Store.save();

    // Pick failure message
    const levelMsgs=FAIL_LEVEL[levelNum];
    const msg=(levelMsgs&&Math.random()>.4)?pick(levelMsgs):pick(FAIL_GENERIC);

    document.getElementById('failMsg').textContent=msg;
    document.getElementById('finalScore').textContent=`Score: ${this.score}`;
    document.getElementById('levelReached').textContent=`Reached Level ${levelNum} of ${this.isDaily?1:10}`;
    const nb=document.getElementById('newBest');
    if(isNewBest){nb.classList.remove('hidden')}else{nb.classList.add('hidden')}
    this.showScreen('gameOverScreen');
    this.updateBestDisplay();
    this.updateSkinSelector();
  },

  victory(){
    this.state='victory';
    Sound.play('victory');
    // Fireworks
    for(let i=0;i<5;i++){
      setTimeout(()=>{
        emitParticles(VW/2+rndRange(-200,200),VH/2+rndRange(-150,100),40,'rainbow',200,1.5,[3,7]);
      },i*300);
    }
    // Update bests
    if(this.score>Store.data.bestScore){Store.data.bestScore=this.score}
    if(10>Store.data.bestLevel){Store.data.bestLevel=10}
    Store.save();
    this.checkUnlock(10);

    document.getElementById('victoryMsg').textContent='You beat all 10 levels!';
    document.getElementById('victoryScore').textContent=`Score: ${this.score}`;
    const nb=document.getElementById('victoryNewBest');
    if(this.score>=Store.data.bestScore){nb.classList.remove('hidden')}else{nb.classList.add('hidden')}
    this.showScreen('victoryScreen');
    this.updateBestDisplay();
    this.updateSkinSelector();
  },

  dailyVictory(){
    this.state='victory';
    Sound.play('victory');
    for(let i=0;i<5;i++){
      setTimeout(()=>{emitParticles(VW/2+rndRange(-200,200),VH/2+rndRange(-100,100),30,'rainbow',180,1.2,[3,6])},i*300);
    }
    const today=getDailySeed().toString();
    Store.data.dailyBest=Math.max(Store.data.dailyBest,this.score);
    Store.data.dailyDate=today;
    Store.save();
    if(Store.unlock('daily')){
      Sound.play('unlock');
      this.showUnlockToast(SKINS.find(s=>s.id==='daily'));
    }
    document.getElementById('victoryMsg').textContent='Daily Challenge Complete!';
    document.getElementById('victoryScore').textContent=`Score: ${this.score}`;
    document.getElementById('victoryNewBest').classList.add('hidden');
    this.showScreen('victoryScreen');
    this.updateBestDisplay();
    this.updateSkinSelector();
  },

  continueAfterVictory(){
    // Continue with harder versions (speed up)
    this.levels=makeLevels().map((lv,i)=>{
      lv.name=`Level ${i+11}`;
      lv.balls.forEach(b=>{b.vx*=1.3;b.vy*=1.3});
      lv.spinners.forEach(s=>{s.speed*=1.3});
      lv.chasers.forEach(c=>{c.speed*=1.2});
      if(lv.timeLimit) lv.timeLimit=Math.max(4,lv.timeLimit*0.8);
      return lv;
    });
    this.currentLevel=0;
    this.loadLevel(0);
    this.showScreen(null);
    this.state='intro';
    this.stateTimer=INTRO_TIME;
  },

  pause(){
    if(this.state!=='playing') return;
    this.prevState=this.state;
    this.state='paused';
    this.showScreen('pauseScreen');
  },

  resume(){
    this.state=this.prevState||'playing';
    this.showScreen(null);
  },

  quit(){
    this.state='menu';
    this.showScreen('startScreen');
    this.updateBestDisplay();
    this.updateSkinSelector();
  },

  share(isVictory){
    Sound.play('click');
    const levelNum=this.currentLevel+1;
    let text;
    if(isVictory){
      text=`🏆 I BEAT Level 10 in 99% FAIL! Score: ${this.score}. Think you can do it?`;
    } else {
      text=`I reached Level ${levelNum} with ${this.score} pts in 99% FAIL! Think you can beat me? 🎮`;
    }
    if(navigator.share){
      navigator.share({title:'99% FAIL',text}).catch(()=>{});
    } else {
      navigator.clipboard.writeText(text).then(()=>{
        const toast=document.createElement('div');
        toast.className='copied-toast';
        toast.textContent='📋 Copied to clipboard!';
        document.body.appendChild(toast);
        setTimeout(()=>toast.remove(),2200);
      }).catch(()=>{});
    }
  },

  // ===== DRAWING =====
  draw(){
    const cw=window.innerWidth,ch=window.innerHeight;
    ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
    // Background
    ctx.fillStyle=C.bg;
    ctx.fillRect(0,0,cw,ch);

    // Apply game transform
    ctx.save();
    ctx.translate(gameOffX,gameOffY);
    ctx.scale(gameScale,gameScale);

    // Screen shake
    if(this.shakeIntensity>0.5){
      ctx.translate((Math.random()-.5)*this.shakeIntensity,(Math.random()-.5)*this.shakeIntensity);
    }

    // Background stars
    drawStars(ctx,performance.now()/1000);

    if(this.state==='menu') {
      ctx.restore();
      this.drawTouchJoystick();
      return;
    }

    // Arena
    const ar=this.getArena();
    ctx.fillStyle=C.arenaBg;
    ctx.fillRect(ar.x,ar.y,ar.w,ar.h);
    ctx.strokeStyle=C.arenaBorder;
    ctx.lineWidth=2;
    ctx.strokeRect(ar.x,ar.y,ar.w,ar.h);

    // Arena glow
    ctx.shadowColor=C.arenaBorder;
    ctx.shadowBlur=15;
    ctx.strokeRect(ar.x,ar.y,ar.w,ar.h);
    ctx.shadowBlur=0;

    // Walls
    for(const w of this.walls){
      ctx.fillStyle=C.wallFill;
      ctx.fillRect(w.x,w.y,w.w,w.h);
      ctx.strokeStyle=C.wall;
      ctx.lineWidth=2;
      ctx.strokeRect(w.x,w.y,w.w,w.h);
      ctx.shadowColor=C.wall;
      ctx.shadowBlur=8;
      ctx.strokeRect(w.x,w.y,w.w,w.h);
      ctx.shadowBlur=0;
    }

    // Phantom walls
    for(const pw of this.phantomWalls){
      const cycle=2.5;
      const t=(this.levelTime+pw.phase)%cycle;
      const visible=t<1.8;
      const alpha=visible?clamp((1.8-t)*3,0.3,0.8):clamp(t-1.8,0,0.15);
      ctx.globalAlpha=alpha;
      ctx.fillStyle=visible?'#3344aa':'#334466';
      ctx.fillRect(pw.x,pw.y,pw.w,pw.h);
      if(visible){
        ctx.strokeStyle='#5566cc';
        ctx.lineWidth=2;
        ctx.strokeRect(pw.x,pw.y,pw.w,pw.h);
      }
      ctx.globalAlpha=1;
    }

    // Fake goal
    if(this.fakeGoal){
      const fg=this.fakeGoal;
      const pulse=Math.sin(this.goalPulse*1.5)*4;
      ctx.shadowColor=C.fakeGoal;
      ctx.shadowBlur=20+pulse;
      ctx.fillStyle=C.fakeGoal;
      ctx.beginPath();
      ctx.arc(fg.x,fg.y,fg.size/2+pulse/2,0,Math.PI*2);
      ctx.fill();
      ctx.shadowBlur=0;
      // Deceptive golden ring
      ctx.strokeStyle='#ffcc00';
      ctx.lineWidth=3;
      ctx.beginPath();
      ctx.arc(fg.x,fg.y,fg.size/2+4+pulse/2,0,Math.PI*2);
      ctx.stroke();
    }

    // Goal
    const gpulse=Math.sin(this.goalPulse)*4;
    ctx.shadowColor=C.goal;
    ctx.shadowBlur=20+gpulse;
    ctx.fillStyle=C.goal;
    ctx.beginPath();
    ctx.arc(this.gx,this.gy,this.gsize/2+gpulse/2,0,Math.PI*2);
    ctx.fill();
    ctx.shadowBlur=0;
    // Inner ring
    ctx.strokeStyle='#fff8';
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(this.gx,this.gy,this.gsize/4,0,Math.PI*2);
    ctx.stroke();

    // Balls
    for(const b of this.balls){
      ctx.shadowColor=C.ball;
      ctx.shadowBlur=12;
      ctx.fillStyle=C.ball;
      ctx.beginPath();
      ctx.arc(b.x,b.y,b.r,0,Math.PI*2);
      ctx.fill();
      ctx.shadowBlur=0;
      // Trail
      ctx.globalAlpha=0.15;
      ctx.beginPath();
      ctx.arc(b.x-b.vx*0.02,b.y-b.vy*0.02,b.r*0.8,0,Math.PI*2);
      ctx.fill();
      ctx.globalAlpha=1;
    }

    // Spinners
    for(const s of this.spinners){
      ctx.save();
      ctx.translate(s.cx,s.cy);
      ctx.rotate(s.angle);
      ctx.shadowColor=C.spinner;
      ctx.shadowBlur=10;
      ctx.fillStyle=C.spinner;
      const hw=s.len/2,hh=s.thick/2;
      ctx.fillRect(-hw,-hh,s.len,s.thick);
      ctx.shadowBlur=0;
      // Center dot
      ctx.fillStyle='#fff';
      ctx.beginPath();
      ctx.arc(0,0,4,0,Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    // Chasers
    for(const c of this.chasers){
      ctx.shadowColor=C.chaser;
      ctx.shadowBlur=15;
      ctx.fillStyle=C.chaser;
      ctx.beginPath();
      ctx.arc(c.x,c.y,c.r,0,Math.PI*2);
      ctx.fill();
      ctx.shadowBlur=0;
      // Eyes
      ctx.fillStyle='#fff';
      const ex=3,ey=-3;
      ctx.beginPath();ctx.arc(c.x-ex,c.y+ey,2.5,0,Math.PI*2);ctx.fill();
      ctx.beginPath();ctx.arc(c.x+ex,c.y+ey,2.5,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='#000';
      ctx.beginPath();ctx.arc(c.x-ex+1,c.y+ey,1.2,0,Math.PI*2);ctx.fill();
      ctx.beginPath();ctx.arc(c.x+ex+1,c.y+ey,1.2,0,Math.PI*2);ctx.fill();
    }

    // Player trail
    const skin=SKINS.find(s=>s.id===Store.data.skin)||SKINS[0];
    for(const t of this.playerTrail){
      ctx.globalAlpha=t.life/0.3*0.25;
      ctx.fillStyle=skin.color==='rainbow'?`hsl(${(performance.now()/10+t.x)%360},100%,60%)`:skin.color;
      ctx.fillRect(t.x-PLAYER_SIZE/4,t.y-PLAYER_SIZE/4,PLAYER_SIZE/2,PLAYER_SIZE/2);
    }
    ctx.globalAlpha=1;

    // Player
    if(this.playerAlive||this.state==='intro'){
      const pcol=skin.color==='rainbow'?`hsl(${(performance.now()/8)%360},100%,60%)`:skin.color;
      ctx.shadowColor=pcol;
      ctx.shadowBlur=skin.glow?15:0;
      ctx.fillStyle=pcol;
      // Rounded rect
      const r=4;
      ctx.beginPath();
      ctx.moveTo(this.px+r,this.py);
      ctx.lineTo(this.px+PLAYER_SIZE-r,this.py);
      ctx.quadraticCurveTo(this.px+PLAYER_SIZE,this.py,this.px+PLAYER_SIZE,this.py+r);
      ctx.lineTo(this.px+PLAYER_SIZE,this.py+PLAYER_SIZE-r);
      ctx.quadraticCurveTo(this.px+PLAYER_SIZE,this.py+PLAYER_SIZE,this.px+PLAYER_SIZE-r,this.py+PLAYER_SIZE);
      ctx.lineTo(this.px+r,this.py+PLAYER_SIZE);
      ctx.quadraticCurveTo(this.px,this.py+PLAYER_SIZE,this.px,this.py+PLAYER_SIZE-r);
      ctx.lineTo(this.px,this.py+r);
      ctx.quadraticCurveTo(this.px,this.py,this.px+r,this.py);
      ctx.fill();
      ctx.shadowBlur=0;
    }

    // Particles
    drawParticles(ctx);

    // Flash texts
    for(const f of this.flashTexts){
      ctx.globalAlpha=clamp(f.life/0.4,0,1);
      ctx.fillStyle=f.color;
      ctx.font='bold 16px "Segoe UI",system-ui,sans-serif';
      ctx.textAlign='center';
      ctx.fillText(f.text,f.x,f.y);
    }
    ctx.globalAlpha=1;

    // Near miss border flash
    if(this.nearMissFlash>0){
      ctx.globalAlpha=this.nearMissFlash*0.3;
      ctx.strokeStyle=C.nearMiss;
      ctx.lineWidth=4;
      ctx.strokeRect(ar.x-2,ar.y-2,ar.w+4,ar.h+4);
      ctx.globalAlpha=1;
    }

    // HUD
    this.drawHUD(ar);

    // Level intro overlay
    if(this.state==='intro'){
      const progress=1-this.stateTimer/INTRO_TIME;
      ctx.globalAlpha=progress<0.3?1-progress/0.3*0.5:progress>0.8?(1-progress)/0.2*0.5:0.5;
      ctx.fillStyle='#000';
      ctx.fillRect(0,0,VW,VH);
      ctx.globalAlpha=1;

      const levelNum=this.isDaily?'📅':(`LEVEL ${this.currentLevel+1}`);
      ctx.fillStyle='#fff';
      ctx.font='bold 48px "Segoe UI",system-ui,sans-serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(levelNum,VW/2,VH/2-20);

      ctx.fillStyle='#ffaa44';
      ctx.font='bold 22px "Segoe UI",system-ui,sans-serif';
      ctx.fillText(this.levelData.name,VW/2,VH/2+25);

      if(this.levelData.hint){
        ctx.fillStyle='#888';
        ctx.font='16px "Segoe UI",system-ui,sans-serif';
        ctx.fillText(this.levelData.hint,VW/2,VH/2+55);
      }
    }

    // Level complete overlay
    if(this.state==='levelComplete'){
      const progress=1-this.stateTimer/LEVEL_COMPLETE_TIME;
      if(progress>0.5){
        ctx.globalAlpha=(progress-0.5)*2;
        ctx.fillStyle='#000';
        ctx.fillRect(0,0,VW,VH);
        ctx.globalAlpha=1;
      }
      ctx.fillStyle=C.goal;
      ctx.font='bold 36px "Segoe UI",system-ui,sans-serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.globalAlpha=Math.min(1,progress*3);
      ctx.fillText('✓ LEVEL COMPLETE!',VW/2,VH/2);
      ctx.globalAlpha=1;
    }

    ctx.restore();

    // Touch joystick (screen space)
    this.drawTouchJoystick();
  },

  drawHUD(ar){
    if(this.state==='intro'||this.state==='dying'||this.state==='levelComplete') {
      // Still show minimal HUD
    }

    const levelNum=this.currentLevel+1;
    ctx.fillStyle='#fff';
    ctx.font='bold 16px "Segoe UI",system-ui,sans-serif';
    ctx.textAlign='left';
    ctx.textBaseline='top';
    ctx.fillText(`Level ${this.isDaily?'📅':levelNum}`,ar.x,ar.y-30);

    ctx.textAlign='right';
    ctx.fillText(`Score: ${this.score}`,ar.x+ar.w,ar.y-30);

    // Timer
    if(this.timeLimit>0&&(this.state==='playing'||this.state==='intro')){
      const remaining=Math.max(0,this.timeLimit-this.levelTime);
      const urgent=remaining<3;
      ctx.textAlign='center';
      ctx.fillStyle=urgent?'#ff3366':'#ffaa44';
      ctx.font=`bold ${urgent?'22':'18'}px "Segoe UI",system-ui,sans-serif`;
      ctx.fillText(`⏱ ${remaining.toFixed(1)}s`,VW/2,ar.y-32);
    }

    // Invert controls indicator
    if(this.invertControls&&(this.state==='playing'||this.state==='intro')){
      ctx.textAlign='center';
      ctx.fillStyle='#ff6688';
      ctx.font='bold 14px "Segoe UI",system-ui,sans-serif';
      ctx.fillText('⚠ CONTROLS REVERSED ⚠',VW/2,ar.y+ar.h+10);
    }

    // Pause hint (desktop only)
    if(this.state==='playing'&&!('ontouchstart' in window)){
      ctx.textAlign='center';
      ctx.fillStyle='#444';
      ctx.font='12px "Segoe UI",system-ui,sans-serif';
      ctx.fillText('ESC to pause • R to restart',VW/2,ar.y+ar.h+14);
    }

    // Near miss counter
    if(this.nearMissCount>0){
      ctx.textAlign='left';
      ctx.fillStyle=C.nearMiss;
      ctx.font='bold 13px "Segoe UI",system-ui,sans-serif';
      ctx.fillText(`⚡ Near misses: ${this.nearMissCount}`,ar.x,ar.y+ar.h+10);
    }
  },

  drawTouchJoystick(){
    if(!Input.touch.active||this.state!=='playing') return;
    const sx=Input.touch.sx,sy=Input.touch.sy;
    const cx=Input.touch.cx,cy=Input.touch.cy;
    const dx=cx-sx,dy=cy-sy;
    const d=Math.hypot(dx,dy);
    const md=Math.min(d,50);
    const angle=Math.atan2(dy,dx);
    const stx=sx+Math.cos(angle)*md;
    const sty=sy+Math.sin(angle)*md;

    // Transform to screen coords (joystick is in screen space)
    ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
    ctx.globalAlpha=0.2;
    ctx.strokeStyle='#fff';
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(sx,sy,50,0,Math.PI*2);
    ctx.stroke();
    ctx.globalAlpha=0.35;
    ctx.fillStyle='#fff';
    ctx.beginPath();
    ctx.arc(stx,sty,18,0,Math.PI*2);
    ctx.fill();
    ctx.globalAlpha=1;
  },
};

// ===== GAME LOOP =====
let lastTime=0;
function loop(timestamp){
  const dt=Math.min((timestamp-lastTime)/1000,0.05);
  lastTime=timestamp;
  game.update(dt);
  game.draw();
  requestAnimationFrame(loop);
}

// ===== INIT =====
game.init();
game.showScreen('startScreen');
requestAnimationFrame(loop);

})();
</script>

            o2.frequency.value=f;g2.gain.setValueAtTime(.15,now+i*.15);
            g2.gain.exponentialRampToValueAtTime(.001,now+i*.15+.3);
            o2.start(now+i*.15);o2.stop(now+i*.15+.3);
          });
          o.stop(now);break;
        }
        case'levelup':
          o.type='sine';o.frequency.setValueAtTime(440,now);o.frequency.setValueAtTime(660,now+.08);
          g.gain.setValueAtTime(.15,now);g.gain.exponentialRampToValueAtTime(.001,now+.2);

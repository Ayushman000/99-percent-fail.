// Collision helpers
function rectsOverlap(ax,ay,aw,ah,bx,by,bw,bh){
  return ax<bx+bw&&ax+aw>bx&&ay<by+bh&&ay+ah>by;
}
function rectCircle(rx,ry,rw,rh,cx,cy,cr){
  const nx=clamp(cx,rx,rx+rw),ny=clamp(cy,ry,ry+rh);
  return(cx-nx)**2+(cy-ny)**2<cr*cr;
}
function pointInRotRect(px,py,cx,cy,hw,hh,angle){
  const c=Math.cos(-angle),s=Math.sin(-angle);
  const dx=px-cx,dy=py-cy;
  const lx=dx*c-dy*s,ly=dx*s+dy*c;
  return Math.abs(lx)<hw&&Math.abs(ly)<hh;
}
function rectRotRectOverlap(rx,ry,rs,cx,cy,hw,hh,angle){
  const pts=[
    [rx,ry],[rx+rs,ry],[rx,ry+rs],[rx+rs,ry+rs],
    [rx+rs/2,ry+rs/2]
  ];
  for(const[px,py]of pts){if(pointInRotRect(px,py,cx,cy,hw,hh,angle))return true}
  return false;
}
function distToRotRect(px,py,cx,cy,hw,hh,angle){
  const c=Math.cos(-angle),s=Math.sin(-angle);
  const dx=px-cx,dy=py-cy;
  const lx=dx*c-dy*s,ly=dx*s+dy*c;
  const clx=clamp(lx,-hw,hw),cly=clamp(ly,-hh,hh);
  return Math.hypot(lx-clx,ly-cly);
}

// ===== SOUND SYSTEM =====
const Sound = {
  ctx: null, muted: false, initialized: false,
  init(){
    if(this.initialized) return;
    try{ this.ctx = new (window.AudioContext||window.webkitAudioContext)(); this.initialized=true; }
    catch(e){ this.muted=true; }
  },
  play(type){
    if(this.muted||!this.ctx)return;
    try{
      const c=this.ctx, now=c.currentTime;
      const o=c.createOscillator(), g=c.createGain();
      o.connect(g); g.connect(c.destination);
      switch(type){
        case'click':
          o.type='sine';o.frequency.value=800;
          g.gain.setValueAtTime(.15,now);g.gain.exponentialRampToValueAtTime(.001,now+.08);

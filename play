          g.gain.setValueAtTime(.15,now);g.gain.exponentialRampToValueAtTime(.001,now+.4);
          o.start(now);o.stop(now+.4);break;
        default: o.stop(now);
      }
    }catch(e){}
  },
  toggle(){ this.muted=!this.muted; }
};

// ===== PARTICLE SYSTEM =====
const particles = [];
function emitParticles(x,y,count,color,speed=100,life=0.8,sizeRange=[2,5]){
  for(let i=0;i<count;i++){
    const angle=Math.random()*Math.PI*2;
    const spd=speed*(0.3+Math.random()*0.7);
    particles.push({
      x,y,
      vx:Math.cos(angle)*spd, vy:Math.sin(angle)*spd,
      life, maxLife:life,
      size:sizeRange[0]+Math.random()*(sizeRange[1]-sizeRange[0]),
      color: color==='rainbow' ? `hsl(${Math.random()*360},100%,60%)` : color,
    });
  }
}
function updateParticles(dt){
  for(let i=particles.length-1;i>=0;i--){
    const p=particles[i];
    p.x+=p.vx*dt; p.y+=p.vy*dt;
    p.vx*=0.97; p.vy*=0.97;
    p.life-=dt;
    if(p.life<=0) particles.splice(i,1);
  }
}
function drawParticles(ctx){
  for(const p of particles){
    const alpha=clamp(p.life/p.maxLife,0,1);
    ctx.globalAlpha=alpha;
    ctx.fillStyle=p.color;
    ctx.fillRect(p.x-p.size/2,p.y-p.size/2,p.size,p.size);
  }
  ctx.globalAlpha=1;
}

